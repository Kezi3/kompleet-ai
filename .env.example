# Copy to .env and fill in only the providers you use. Never commit real keys.
# Optional: force a provider (claude | openai | kimi | fallback)
AI_PROVIDER=
ANTHROPIC_API_KEY=your-anthropic-api-key
# Optional override for the Claude categorisation model
ANTHROPIC_CATEGORIZE_MODEL=
OPENAI_API_KEY=your-openai-api-key
KIMI_API_KEY=your-kimi-api-key
